{
    "$schema": "http://json.schemastore.org/template",
    "author": "Grove Games",
    "classifications": [
        "Library",
        "Package"
    ],
    "name": "Package Template",
    "identity": "GroveGames.Package",
    "shortName": "package",
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "sourceName": "GroveGames.Package",
    "preferNameDirectory": true,
    "symbols": {
        "name": {
            "type": "parameter",
            "isRequired": true,
            "description": "Name of the package.",
            "replaces": "{{Name}}",
            "fileRename": "{{Name}}"
        },
        "pascalCaseName": {
            "type": "derived",
            "valueSource": "name",
            "valueTransform": "pascalCase",
            "replaces": "{{Name(P)}}",
            "fileRename": "{{Name(P)}}"
        },
        "kebabCaseName": {
            "type": "derived",
            "valueSource": "name",
            "valueTransform": "kebabCase",
            "replaces": "{{Name(K)}}",
            "fileRename": "{{Name(K)}}"
        },
        "lowerCaseName": {
            "type": "derived",
            "valueSource": "name",
            "valueTransform": "lowerCase",
            "replaces": "{{Name(L)}}",
            "fileRename": "{{Name(L)}}"
        },
        "author": {
            "type": "parameter",
            "isRequired": true,
            "description": "Author of the package.",
            "replaces": "{{Author}}",
            "fileRename": "{{Author}}"
        },
        "pascalCaseAuthor": {
            "type": "derived",
            "valueSource": "author",
            "valueTransform": "pascalCase",
            "replaces": "{{Author(P)}}",
            "fileRename": "{{Author(P)}}"
        },
        "kebabCaseAuthor": {
            "type": "derived",
            "valueSource": "author",
            "valueTransform": "kebabCase",
            "replaces": "{{Author(K)}}",
            "fileRename": "{{Author(K)}}"
        },
        "lowerCaseAuthor": {
            "type": "derived",
            "valueSource": "author",
            "valueTransform": "lowerCase",
            "replaces": "{{Author(L)}}",
            "fileRename": "{{Author(L)}}"
        },
        "github": {
            "type": "parameter",
            "isRequired": true,
            "description": "The GitHub username associated with the package.",
            "dataType": "text",
            "replaces": "{{Github}}"
        },
        "description": {
            "type": "parameter",
            "defaultValue": "",
            "description": "Description of the package.",
            "dataType": "text",
            "replaces": "{{Description}}"
        },
        "tags": {
            "type": "parameter",
            "defaultValue": "",
            "description": "Semicolon-separated tags that categorize the package in kebab case.",
            "dataType": "text",
            "replaces": "{{Tags}}"
        },
        "UnityEditorMetaGuid": {
            "type": "generated",
            "generator": "guid",
            "parameters": {
                "defaultFormat": "n"
            },
            "replaces": "{{UnityEditorMetaGuid}}"
        },
        "UnityRuntimeMetaGuid": {
            "type": "generated",
            "generator": "guid",
            "parameters": {
                "defaultFormat": "n"
            },
            "replaces": "{{UnityRuntimeMetaGuid}}"
        },
        "UnityTestsMetaGuid": {
            "type": "generated",
            "generator": "guid",
            "parameters": {
                "defaultFormat": "n"
            },
            "replaces": "{{UnityTestsMetaGuid}}"
        },
        "UnityTestsEditorMetaGuid": {
            "type": "generated",
            "generator": "guid",
            "parameters": {
                "defaultFormat": "n"
            },
            "replaces": "{{UnityTestsEditorMetaGuid}}"
        },
        "UnityTestsRuntimeMetaGuid": {
            "type": "generated",
            "generator": "guid",
            "parameters": {
                "defaultFormat": "n"
            },
            "replaces": "{{UnityTestsRuntimeMetaGuid}}"
        },
        "UnityPackageJsonMetaGuid": {
            "type": "generated",
            "generator": "guid",
            "parameters": {
                "defaultFormat": "n"
            },
            "replaces": "{{UnityPackageJsonMetaGuid}}"
        },
        "UnityRuntimeAsmdefMetaGuid": {
            "type": "generated",
            "generator": "guid",
            "parameters": {
                "defaultFormat": "n"
            },
            "replaces": "{{UnityRuntimeAsmdefMetaGuid}}"
        },
        "UnityEditorAssemblyInfoMetaGuid": {
            "type": "generated",
            "generator": "guid",
            "parameters": {
                "defaultFormat": "n"
            },
            "replaces": "{{UnityEditorAssemblyInfoMetaGuid}}"
        },
        "UnityRuntimeAssemblyInfoMetaGuid": {
            "type": "generated",
            "generator": "guid",
            "parameters": {
                "defaultFormat": "n"
            },
            "replaces": "{{UnityRuntimeAssemblyInfoMetaGuid}}"
        },
        "UnityRuntimeCscRspMetaGuid": {
            "type": "generated",
            "generator": "guid",
            "parameters": {
                "defaultFormat": "n"
            },
            "replaces": "{{UnityRuntimeCscRspMetaGuid}}"
        },
        "UnityEditorCscRspMetaGuid": {
            "type": "generated",
            "generator": "guid",
            "parameters": {
                "defaultFormat": "n"
            },
            "replaces": "{{UnityEditorCscRspMetaGuid}}"
        },
        "UnityTestsRuntimeCscRspMetaGuid": {
            "type": "generated",
            "generator": "guid",
            "parameters": {
                "defaultFormat": "n"
            },
            "replaces": "{{UnityTestsRuntimeCscRspMetaGuid}}"
        },
        "UnityTestsEditorCscRspMetaGuid": {
            "type": "generated",
            "generator": "guid",
            "parameters": {
                "defaultFormat": "n"
            },
            "replaces": "{{UnityTestsEditorCscRspMetaGuid}}"
        }
    },
    "forms": {
        "titleCase": {
            "identifier": "titleCase"
        },
        "invalidChars": {
            "identifier": "replace",
            "pattern": "([\\-_\\.\\ ])",
            "replacement": ""
        },
        "pascalCase": {
            "identifier": "chain",
            "steps": [
                "titleCase",
                "invalidChars"
            ]
        },
        "kebabCase": {
            "identifier": "kebabCase"
        },
        "lowerCase": {
            "identifier": "chain",
            "steps": [
                "invalidChars",
                "lowerCaseInvariant"
            ]
        },
        "lowerCaseInvariant": {
            "identifier": "lowerCaseInvariant"
        },
        "firstLowerCase": {
            "identifier": "firstLowerCaseInvariant"
        }
    },
    "SpecialCustomOperations": {
        "**/Polyfills/**/*.cs": {
            "operations": []
        }
    },
    "sources": [
        {
            "source": "./src",
            "target": "./"
        }
    ],
    "postActions": [
        {
            "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
            "args": {
                "executable": "bash",
                "args": "setup_package.sh"
            },
            "manualInstructions": [
                {
                    "text": "Run 'setup_package.sh' manually if this fails to complete the setup process."
                }
            ],
            "continueOnError": false,
            "description": "Executes the setup script to finalize the template initialization."
        }
    ]
}
